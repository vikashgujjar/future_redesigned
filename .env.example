# Base URL of the Laravel CMS/admin API (see ../future-touch-services-admin).
# Wired into every page's server-side data fetch (app/lib/cms.js) — a CMS
# outage or missing value can never break the build, pages fall back to
# their bundled local content.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Firebase project used for the OTP-verification flow (lead forms). Not a
# secret by Firebase's own design (access is controlled by Firebase Security
# Rules, not by hiding this config) — env-driven here so a different Firebase
# project can be used per environment without a code change.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google Maps Platform key used client-side to fetch Google Reviews for the
# Testimonials section (via a third-party reviews proxy). Google API keys
# used from the browser are inherently public once shipped — restrict this
# key's allowed referrers/APIs in the Google Cloud Console, not here.
NEXT_PUBLIC_GOOGLE_REVIEWS_API_KEY=

# Lead-form OTP verification backend. Optional — defaults to the production
# enquiry.futuretouch.org endpoint in code if unset.
# NEXT_PUBLIC_OTP_API_URL=https://enquiry.futuretouch.org/api

# Lead email-notification backend, hit by every lead form on the site (see
# app/lib/useOtpFlow.js's sendLeadNotification). Set this to the Laravel
# admin's own /api/v1 (MailProxyController) so every submission is ALSO
# stored in the admin panel — it forwards the same payload on to the real
# mail.futuretouch.org service, so the email notification still fires.
# Leaving this unset falls back to calling mail.futuretouch.org directly,
# same as before this admin was built (no admin storage in that case).
NEXT_PUBLIC_MAIL_API_URL=http://localhost:8000/api/v1
